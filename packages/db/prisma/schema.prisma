datasource db {
  provider = "postgresql"
}

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  // CRM ownership. Better Auth owns every field above and `bun run
  // auth:generate` rewrites them; these back-relations are ours and have to be
  // put back if that ever wipes them.
  ownedCompanies    Company[]             @relation("CompanyOwner")
  ownedContacts     Contact[]             @relation("ContactOwner")
  ownedDeals        Deal[]                @relation("DealOwner")
  activities        Activity[]            @relation("ActivityAuthor")
  mailboxSyncs      MailboxSync[]
  factDecisions     ContactFact[]         @relation("FactDecider")
  conversations     AgentConversation[]   @relation("ConversationOwner")

  // Governance is deliberately outside Better Auth's generated columns. The
  // identity provider owns authentication; CRM roles and scope memberships own
  // what that identity may do after it signs in.
  access                   UserAccess?
  businessUnitMemberships  BusinessUnitMembership[]
  teamMemberships          TeamMembership[]
  ledBusinessUnits         BusinessUnit[]             @relation("BusinessUnitLeader")
  ledTeams                 Team[]                     @relation("TeamLeader")
  contactUnitOwnerships    ContactBusinessUnitState[] @relation("ContactUnitOwner")
  companyUnitOwnerships    CompanyBusinessUnitState[] @relation("CompanyUnitOwner")
  globalMqlQualifications  Contact[]                  @relation("ContactGlobalQualifier")
  unitMqlQualifications    ContactBusinessUnitState[] @relation("ContactUnitQualifier")
  ownedCustomObjectRecords CustomObjectRecord[]       @relation("CustomObjectOwner")
  createdApiCredentials    ApiCredential[]            @relation("ApiCredentialCreator")
  createdAutomations       Automation[]               @relation("AutomationCreator")
  createdWebhookEndpoints  WebhookEndpoint[]          @relation("WebhookEndpointCreator")
  ownedRevenueAccounts     RevenueAccount[]           @relation("RevenueAccountOwner")
  ownedDashboards          Dashboard[]                 @relation("DashboardOwner")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// ---------------------------------------------------------------------------
// CRM
//
// Companies are the top-level object; contacts and deals hang off them, and
// everything that happens is an Activity on a timeline.
// ---------------------------------------------------------------------------

enum PipelineStageType {
  OPEN
  WON
  LOST
  UNQUALIFIED
}

/// The revenue motion a pipeline represents. The API uses stable lower-case
/// wire values and maps them to this persisted enum.
enum PipelineFunnelType {
  FULL_BOWTIE
  LEFT_SIDE
  RIGHT_SIDE
  CUSTOM
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
  /// A manually logged SMS or WhatsApp exchange.
  MESSAGE
  /// A lead submitted a managed marketing form.
  FORM_CONVERSION
  /// A lead attended a managed marketing event.
  EVENT_ATTENDANCE
  /// Written by the system when Deal.stage changes.
  STAGE_CHANGE
  /// Written by the enrichment agent.
  ENRICHMENT
}

/// A normalized touch/conversion can belong to any revenue element. Typed
/// foreign keys preserve referential integrity while entityId keeps history
/// queries uniform across the ontology.
enum ConversionEntityType {
  CONTACT
  COMPANY
  DEAL
  REVENUE_ACCOUNT
}

enum EnrichmentStatus {
  PENDING
  RUNNING
  COMPLETE
  /// The lookup failed and is worth retrying — see Company.enrichmentError.
  FAILED
  /// There is nothing to find (unknown domain, free email host). Not an error.
  SKIPPED
}

/// Where a record came from. Auto-created rows are tagged so a bad matching
/// rule is visible and reversible in bulk, rather than silently indistinguishable
/// from something a rep typed.
enum RecordSource {
  MANUAL
  IMPORT
  EMAIL
  CALENDAR
}

enum LifecycleStage {
  LEAD
  MQL
  SQL
  OPPORTUNITY
  CUSTOMER
  DISQUALIFIED
}

enum UserAccessStatus {
  ACTIVE
  SUSPENDED
}

/// The action is RBAC; the scope is the organisational boundary applied to it.
enum PermissionAction {
  READ
  CREATE
  UPDATE
  ARCHIVE
  RESTORE
  DESTROY
  TRANSFER
  MANAGE
  EXPORT
}

enum AccessScope {
  NONE
  OWNED
  TEAM
  MANAGED_TEAMS
  BUSINESS_UNIT
  BUSINESS_UNIT_TREE
  ALL
}

enum DashboardDefinitionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DashboardVisibility {
  PRIVATE
  PUBLIC
}

enum BusinessUnitMembershipType {
  MEMBER
  MANAGER
  ADMIN
}

enum ObjectDefinitionKind {
  SYSTEM
  CUSTOM
}

enum CustomFieldType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
  DATE
  DATE_TIME
  EMAIL
  PHONE
  URL
  CURRENCY
  RELATION
}

enum CustomFieldIndexMode {
  BASIC
  INDEXED
  UNIQUE
}

enum DataClassification {
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum RelationCardinality {
  ONE_TO_ONE
  ONE_TO_MANY
  MANY_TO_MANY
}

enum RevenueAccountTargetKind {
  CONTACT
  COMPANY
  DEAL
}

enum RevenueAccountMergeFieldPolicy {
  TARGET
  SOURCE
  UNION
  SKIP
}

enum RevenueAccountLineageEventType {
  CREATED
  UPDATED
  ARCHIVED
  RELATION_ATTACHED
  RELATION_DETACHED
  MERGED_IN
  MERGED_OUT
}

enum OntologySchemaVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LeadSubmissionStatus {
  ACCEPTED
  REJECTED
  DUPLICATE
  NEEDS_REVIEW
}

enum AuditActorType {
  USER
  API_KEY
  AUTOMATION
  AGENT
  SYSTEM
}

enum ApiCredentialStatus {
  ACTIVE
  REVOKED
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum AutomationRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  DEAD
}

enum WebhookDeliveryStatus {
  PENDING
  LEASED
  SUCCEEDED
  FAILED
  DEAD
}

model BusinessUnit {
  id   String @id @default(cuid())
  key  String @unique
  name String

  parentId String?
  parent   BusinessUnit?  @relation("BusinessUnitTree", fields: [parentId], references: [id], onDelete: Restrict)
  children BusinessUnit[] @relation("BusinessUnitTree")

  leaderId   String?
  leader     User?     @relation("BusinessUnitLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  archivedAt DateTime?

  ancestorPaths        BusinessUnitClosure[]        @relation("BusinessUnitAncestor")
  descendantPaths      BusinessUnitClosure[]        @relation("BusinessUnitDescendant")
  teams                Team[]
  memberships          BusinessUnitMembership[]
  primaryUsers         UserAccess[]
  contactStates        ContactBusinessUnitState[]
  companyStates        CompanyBusinessUnitState[]
  deals                Deal[]
  activities           Activity[]
  conversionEvents     ConversionAttributionEvent[] @relation("ConversionBusinessUnit")
  pipelines            Pipeline[]
  products             Product[]
  marketingForms       MarketingForm[]
  marketingEvents      MarketingEvent[]
  objectDefinitions    ObjectDefinition[]
  customFields         CustomFieldDefinition[]
  customRecords        CustomObjectRecord[]
  relations            RecordRelation[]
  leadSubmissions      LeadSubmission[]
  credentialScopes     ApiCredentialBusinessUnit[]
  automations          Automation[]
  domainEvents         DomainEvent[]
  webhookEndpoints     WebhookEndpoint[]
  auditEvents          AuditEvent[]
  revenueAccounts      RevenueAccount[]
  dashboardDefinitions DashboardDefinition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([leaderId])
  @@index([archivedAt, name])
  @@map("businessUnit")
}

/// Transitive closure makes BUSINESS_UNIT_TREE a bounded indexed lookup, not a
/// recursive traversal on every CRM list query.
model BusinessUnitClosure {
  ancestorId   String
  ancestor     BusinessUnit @relation("BusinessUnitAncestor", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendantId String
  descendant   BusinessUnit @relation("BusinessUnitDescendant", fields: [descendantId], references: [id], onDelete: Cascade)
  depth        Int

  @@id([ancestorId, descendantId])
  @@index([descendantId, depth])
  @@map("businessUnitClosure")
}

model Team {
  id             String       @id @default(cuid())
  businessUnitId String
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  key            String
  name           String
  leaderId       String?
  leader         User?        @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  archivedAt     DateTime?

  memberships      TeamMembership[]
  primaryUsers     UserAccess[]
  contactStates    ContactBusinessUnitState[]
  companyStates    CompanyBusinessUnitState[]
  deals            Deal[]
  activities       Activity[]
  conversionEvents ConversionAttributionEvent[] @relation("ConversionTeam")
  customRecords    CustomObjectRecord[]
  leadSubmissions  LeadSubmission[]
  credentialScopes ApiCredentialTeam[]
  automations      Automation[]
  domainEvents     DomainEvent[]
  webhookEndpoints WebhookEndpoint[]
  auditEvents      AuditEvent[]
  revenueAccounts  RevenueAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessUnitId, key])
  @@index([leaderId])
  @@index([archivedAt, name])
  @@map("team")
}

model BusinessUnitMembership {
  userId         String
  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessUnitId String
  businessUnit   BusinessUnit               @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  type           BusinessUnitMembershipType @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, businessUnitId])
  @@index([businessUnitId, type])
  @@map("businessUnitMembership")
}

model TeamMembership {
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId String
  team   Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  isLead Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, teamId])
  @@index([teamId, isLead])
  @@map("teamMembership")
}

model Role {
  id          String    @id @default(cuid())
  key         String    @unique
  name        String
  description String?
  isSystem    Boolean   @default(false)
  isAdmin     Boolean   @default(false)
  archivedAt  DateTime?

  users            UserAccess[]
  permissions      RolePermission[]
  fieldPermissions FieldPermission[]
  apiCredentials   ApiCredential[]
  automations      Automation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([archivedAt, name])
  @@map("role")
}

model UserAccess {
  userId String           @id
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status UserAccessStatus @default(ACTIVE)

  primaryBusinessUnitId String?
  primaryBusinessUnit   BusinessUnit? @relation(fields: [primaryBusinessUnitId], references: [id], onDelete: SetNull)
  primaryTeamId         String?
  primaryTeam           Team?         @relation(fields: [primaryTeamId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId, status])
  @@index([primaryBusinessUnitId])
  @@index([primaryTeamId])
  @@map("userAccess")
}

model RolePermission {
  id       String           @id @default(cuid())
  roleId   String
  role     Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource String
  action   PermissionAction
  scope    AccessScope      @default(NONE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, resource, action])
  @@index([resource, action])
  @@map("rolePermission")
}

model ObjectDefinition {
  id          String               @id @default(cuid())
  key         String               @unique
  name        String
  pluralName  String
  kind        ObjectDefinitionKind @default(SYSTEM)
  systemModel String?

  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  archivedAt     DateTime?

  fields          CustomFieldDefinition[]
  sourceRelations ObjectRelationDefinition[] @relation("RelationSourceObject")
  targetRelations ObjectRelationDefinition[] @relation("RelationTargetObject")
  customRecords   CustomObjectRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessUnitId, archivedAt])
  @@map("objectDefinition")
}

/// Provider-neutral dashboard definitions. Every version is retained so a
/// published chart can be explained or reproduced after later edits.
model DashboardDefinition {
  id             String                    @id @default(cuid())
  key            String
  name           String
  description    String?
  version        Int                       @default(1)
  status         DashboardDefinitionStatus @default(DRAFT)
  spec           Json
  businessUnitId String?
  businessUnit   BusinessUnit?             @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  createdByType  AuditActorType
  createdById    String?
  updatedByType  AuditActorType?
  updatedById    String?
  publishedAt    DateTime?
  archivedAt     DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([key, version])
  @@index([businessUnitId, status, updatedAt])
  @@index([key, status])
  @@map("dashboardDefinition")
}

/// A user-facing canvas. Definitions remain reusable governed metric recipes;
/// dashboards arrange copies of those recipes for a concrete audience.
model Dashboard {
  id          String              @id @default(cuid())
  name        String
  description String?
  visibility  DashboardVisibility @default(PRIVATE)
  ownerId     String
  owner       User                @relation("DashboardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  widgets     DashboardWidget[]
  archivedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([ownerId, archivedAt, updatedAt])
  @@index([visibility, archivedAt, updatedAt])
  @@map("dashboard")
}

model DashboardWidget {
  id          String    @id @default(cuid())
  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  title       String
  description String?
  spec        Json
  position    Int       @default(0)
  width       Int       @default(6)
  height      Int       @default(4)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([dashboardId, position])
  @@map("dashboardWidget")
}

model CustomFieldDefinition {
  id                 String               @id @default(cuid())
  objectDefinitionId String
  objectDefinition   ObjectDefinition     @relation(fields: [objectDefinitionId], references: [id], onDelete: Cascade)
  businessUnitId     String?
  businessUnit       BusinessUnit?        @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  key                String
  label              String
  description        String?
  type               CustomFieldType
  indexMode          CustomFieldIndexMode @default(BASIC)
  classification     DataClassification   @default(INTERNAL)
  position           Int                  @default(0)
  isRequired         Boolean              @default(false)
  defaultValue       Json?
  agentReadable      Boolean              @default(false)
  agentWritable      Boolean              @default(false)
  apiReadable        Boolean              @default(true)
  apiWritable        Boolean              @default(true)
  archivedAt         DateTime?

  options     CustomFieldOption[]
  values      CustomFieldSearchValue[]
  permissions FieldPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // PostgreSQL adds a partial unique index for global definitions in the
  // migration; nullable compound uniqueness alone would allow duplicate keys.
  @@unique([objectDefinitionId, businessUnitId, key])
  @@index([objectDefinitionId, position])
  @@index([businessUnitId, archivedAt])
  @@map("customFieldDefinition")
}

model CustomFieldOption {
  id         String                @id @default(cuid())
  fieldId    String
  field      CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  key        String
  label      String
  position   Int                   @default(0)
  color      String?
  archivedAt DateTime?

  indexedValues CustomFieldSearchValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fieldId, key])
  @@index([fieldId, position])
  @@map("customFieldOption")
}

model FieldPermission {
  id        String                @id @default(cuid())
  roleId    String
  role      Role                  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  fieldId   String
  field     CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  canRead   Boolean               @default(true)
  canUpdate Boolean               @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, fieldId])
  @@index([fieldId])
  @@map("fieldPermission")
}

/// JSONB is the record read path. This table is a sparse typed projection only
/// for fields marked INDEXED or UNIQUE, keeping arbitrary fields cheap while
/// making range, sort and uniqueness queries predictable.
model CustomFieldSearchValue {
  id      String                @id @default(cuid())
  fieldId String
  field   CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  companyId                  String?
  company                    Company?                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId                  String?
  contact                    Contact?                  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyBusinessUnitStateId String?
  companyBusinessUnitState   CompanyBusinessUnitState? @relation(fields: [companyBusinessUnitStateId], references: [id], onDelete: Cascade)
  contactBusinessUnitStateId String?
  contactBusinessUnitState   ContactBusinessUnitState? @relation(fields: [contactBusinessUnitStateId], references: [id], onDelete: Cascade)
  dealId                     String?
  deal                       Deal?                     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  revenueAccountId           String?
  revenueAccount             RevenueAccount?           @relation(fields: [revenueAccountId], references: [id], onDelete: Cascade)
  customObjectRecordId       String?
  customObjectRecord         CustomObjectRecord?       @relation(fields: [customObjectRecordId], references: [id], onDelete: Cascade)

  textValue             String?
  normalizedTextValue   String?
  numberValue           Decimal?           @db.Decimal(30, 10)
  booleanValue          Boolean?
  dateValue             DateTime?
  jsonValue             Json?
  optionId              String?
  option                CustomFieldOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)
  uniqueNormalizedValue String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fieldId, companyId])
  @@unique([fieldId, contactId])
  @@unique([fieldId, companyBusinessUnitStateId])
  @@unique([fieldId, contactBusinessUnitStateId])
  @@unique([fieldId, dealId])
  @@unique([fieldId, revenueAccountId])
  @@unique([fieldId, customObjectRecordId])
  @@index([fieldId, normalizedTextValue])
  @@index([fieldId, numberValue])
  @@index([fieldId, booleanValue])
  @@index([fieldId, dateValue])
  @@index([fieldId, optionId])
  @@map("customFieldSearchValue")
}

model ObjectRelationDefinition {
  id             String              @id @default(cuid())
  sourceObjectId String
  sourceObject   ObjectDefinition    @relation("RelationSourceObject", fields: [sourceObjectId], references: [id], onDelete: Cascade)
  targetObjectId String
  targetObject   ObjectDefinition    @relation("RelationTargetObject", fields: [targetObjectId], references: [id], onDelete: Cascade)
  key            String
  name           String
  inverseName    String
  cardinality    RelationCardinality @default(MANY_TO_MANY)
  archivedAt     DateTime?

  records RecordRelation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceObjectId, key])
  @@index([targetObjectId])
  @@map("objectRelationDefinition")
}

/// Versioned governance journal for the live Fields ontology. Definitions and
/// records remain in their existing runtime tables; this snapshot is the
/// auditable, immutable contract that was reviewed and published.
model OntologySchemaDefinition {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?

  versions  OntologySchemaVersion[]
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  @@map("ontologySchemaDefinition")
}

model OntologySchemaVersion {
  id                 String                     @id @default(cuid())
  schemaDefinitionId String
  schemaDefinition   OntologySchemaDefinition  @relation(fields: [schemaDefinitionId], references: [id], onDelete: Cascade)
  version            Int
  status             OntologySchemaVersionStatus @default(DRAFT)
  snapshot           Json
  checksum           String
  createdByType      AuditActorType
  createdById        String?
  publishedAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime                   @default(now())

  @@unique([schemaDefinitionId, version])
  @@index([schemaDefinitionId, status])
  @@index([status, createdAt])
  @@map("ontologySchemaVersion")
}

model RecordRelation {
  id                   String                   @id @default(cuid())
  relationDefinitionId String
  relationDefinition   ObjectRelationDefinition @relation(fields: [relationDefinitionId], references: [id], onDelete: Cascade)
  sourceRecordId       String
  targetRecordId       String
  businessUnitId       String?
  businessUnit         BusinessUnit?            @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  createdByType        AuditActorType
  createdById          String?

  createdAt DateTime @default(now())

  @@unique([relationDefinitionId, sourceRecordId, targetRecordId])
  @@index([relationDefinitionId, targetRecordId])
  @@index([businessUnitId])
  @@map("recordRelation")
}

model CustomObjectRecord {
  id                 String           @id @default(cuid())
  objectDefinitionId String
  objectDefinition   ObjectDefinition @relation(fields: [objectDefinitionId], references: [id], onDelete: Restrict)
  businessUnitId     String
  businessUnit       BusinessUnit     @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  teamId             String?
  team               Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  ownerId            String?
  owner              User?            @relation("CustomObjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  displayName        String
  customValues       Json             @default("{}")
  archivedAt         DateTime?

  indexedCustomValues CustomFieldSearchValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([objectDefinitionId, businessUnitId, archivedAt])
  @@index([teamId, ownerId])
  @@map("customObjectRecord")
}

model Company {
  id          String  @id @default(cuid())
  name        String
  /// Bare and normalised ("stripe.com"). Unique because two records for one
  /// domain is the fastest way to rot a CRM, and it is the enrichment key.
  domain      String? @unique
  website     String?
  description String?

  // Brand, from Context.dev.
  logoUrl     String?
  logoDarkUrl String?
  /// Square mark, used in table rows.
  iconUrl     String?
  /// The dark-mode square mark, when the brand publishes one. Rare — most
  /// brands ship a light-mode logo only, which is what `iconTone` is for.
  iconDarkUrl String?
  /// How `iconUrl` behaves against a background, from Context.dev's `mode` plus
  /// the artwork's own dominant colour:
  ///
  /// - `opaque`  — the icon is composed on its own background; never put a
  ///               surface behind it.
  /// - `dark`    — dark artwork on transparency; invisible in dark mode without
  ///               a light surface behind it.
  /// - `light`   — light artwork on transparency; the same problem in reverse.
  iconTone    String?
  /// Hex. An accent only — brand colours would fight the design tokens.
  brandColor  String?

  // Firmographics.
  industry    String?
  subIndustry String?
  city        String?
  stateCode   String?
  country     String?
  countryCode String?

  // Contact details and socials.
  phone       String?
  email       String?
  linkedinUrl String?
  twitterUrl  String?
  githubUrl   String?
  pricingUrl  String?
  careersUrl  String?

  ownerId          String?
  owner            User?    @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  primaryContactId String?  @unique
  primaryContact   Contact? @relation("PrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)

  enrichmentStatus EnrichmentStatus   @default(PENDING)
  enrichedAt       DateTime?
  enrichmentError  String?
  enrichment       CompanyEnrichment?

  /// MANUAL unless a sync created it. Filterable, so a bad auto-create rule can
  /// be undone in bulk.
  source       RecordSource @default(MANUAL)
  archivedAt   DateTime?
  customValues Json         @default("{}")

  /// Denormalised max(activity.createdAt), written with the activity.
  ///
  /// A real column because it is a sortable column on every list, and ordering
  /// by an aggregate over a relation is something Prisma cannot express — the
  /// alternative is a correlated subquery per row, which would be the slowest
  /// thing on the page. Maintained through `ActivityStampService`.
  lastActivityAt DateTime?

  contacts            Contact[]                    @relation("CompanyContacts")
  conversations       AgentConversation[]
  deals               Deal[]
  revenueAccounts     RevenueAccountCompany[]
  activities          Activity[]
  agentTasks          AgentTask[]
  conversionEvents    ConversionAttributionEvent[] @relation("ConversionCompany")
  emailThreads        EmailThread[]
  calendarEvents      CalendarEvent[]
  unitStates          CompanyBusinessUnitState[]
  indexedCustomValues CustomFieldSearchValue[]
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@index([ownerId])
  @@index([name])
  @@index([lastActivityAt])
  @@index([archivedAt])
  @@map("company")
}

/// The raw Context.dev payload, kept so re-deriving a field costs nothing and
/// no credits.
model CompanyEnrichment {
  companyId String   @id
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source    String   @default("context.dev")
  raw       Json
  fetchedAt DateTime @default(now())

  @@map("companyEnrichment")
}

model Contact {
  id          String  @id @default(cuid())
  firstName   String
  lastName    String?
  /// Unique, matching HubSpot, so a CSV import can be re-run safely. The cost:
  /// two people behind one info@ address need one email between them.
  email       String? @unique
  phone       String?
  title       String?
  linkedinUrl String?
  twitterUrl  String?
  githubUrl   String?
  /// The contact's photo, mirrored into Vercel Blob.
  ///
  /// Never LinkedIn's own CDN URL: those carry an `e=` expiry parameter and go
  /// dead within weeks, so a hotlinked avatar silently becomes a broken image.
  imageUrl    String?

  // First-touch marketing attribution. Later touches stay on conversion and
  // attendance activities, preserving the journey without overwriting origin.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  /// When the agent last went looking for this person's X and GitHub accounts.
  ///
  /// Stamped whether or not it found any, which is the point: most people have
  /// neither, and without it the hourly run would search the same fruitless
  /// contacts forever. Null means never looked; a date with both URLs still
  /// null means looked and found nothing it could stand behind.
  socialsCheckedAt DateTime?

  /// Mirrors `Company`, so the sheet reuses `isEnriching()` and the existing
  /// poll rather than inventing a second freshness mechanism.
  enrichmentStatus EnrichmentStatus @default(PENDING)
  enrichedAt       DateTime?
  enrichmentError  String?

  // Consolidated business view. Unit-specific qualification remains on
  // ContactBusinessUnitState and is the source of truth for where it happened.
  globalLifecycleStage             LifecycleStage @default(LEAD)
  globalMarketingScore             Decimal?       @db.Decimal(12, 4)
  globallyMarketingQualifiedAt     DateTime?
  globallyMarketingQualifiedReason String?
  globallyMarketingQualifiedById   String?
  globallyMarketingQualifiedBy     User?          @relation("ContactGlobalQualifier", fields: [globallyMarketingQualifiedById], references: [id], onDelete: SetNull)

  /// Who this person is (§3 of the contact-intelligence plan) and every claim
  /// behind the fields above.
  brief         ContactBrief?
  facts         ContactFact[]
  conversations AgentConversation[]

  companyId String?
  company   Company? @relation("CompanyContacts", fields: [companyId], references: [id], onDelete: SetNull)
  ownerId   String?
  owner     User?    @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  primaryOf Company? @relation("PrimaryContact")

  source       RecordSource @default(MANUAL)
  archivedAt   DateTime?
  customValues Json         @default("{}")

  /// Denormalised max(activity.createdAt), written with the activity.
  ///
  /// A real column because it is a sortable column on every list, and ordering
  /// by an aggregate over a relation is something Prisma cannot express — the
  /// alternative is a correlated subquery per row, which would be the slowest
  /// thing on the page. Maintained through `ActivityStampService`.
  lastActivityAt DateTime?

  deals               DealContact[]
  revenueAccounts     RevenueAccountContact[]
  activities          Activity[]
  agentTasks          AgentTask[]
  conversionEvents    ConversionAttributionEvent[] @relation("ConversionContact")
  emailThreads        EmailThread[]
  calendarEvents      CalendarEvent[]
  eventAttendance     CalendarAttendee[]
  unitStates          ContactBusinessUnitState[]
  leadSubmissions     LeadSubmission[]
  indexedCustomValues CustomFieldSearchValue[]
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@index([companyId])
  @@index([ownerId])
  @@index([globalLifecycleStage, globallyMarketingQualifiedAt])
  @@index([globallyMarketingQualifiedById])
  @@index([lastActivityAt])
  @@index([archivedAt])
  @@map("contact")
}

/// One canonical person can be a lead for one unit and an MQL for another. The
/// global Contact status is a consolidation; this row owns the commercial fact.
model ContactBusinessUnitState {
  id             String       @id @default(cuid())
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  businessUnitId String
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  teamId         String?
  team           Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  ownerId        String?
  owner          User?        @relation("ContactUnitOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  lifecycleStage           LifecycleStage @default(LEAD)
  marketingScore           Decimal?       @db.Decimal(12, 4)
  marketingQualifiedAt     DateTime?
  marketingQualifiedReason String?
  marketingQualifiedById   String?
  marketingQualifiedBy     User?          @relation("ContactUnitQualifier", fields: [marketingQualifiedById], references: [id], onDelete: SetNull)

  leadSource   String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmTerm      String?
  utmContent   String?
  customValues Json      @default("{}")
  archivedAt   DateTime?

  indexedCustomValues CustomFieldSearchValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contactId, businessUnitId])
  @@index([businessUnitId, lifecycleStage, marketingQualifiedAt])
  @@index([teamId, ownerId])
  @@index([marketingQualifiedById])
  @@index([archivedAt])
  @@map("contactBusinessUnitState")
}

model CompanyBusinessUnitState {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  businessUnitId String
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  teamId         String?
  team           Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  ownerId        String?
  owner          User?        @relation("CompanyUnitOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  customValues   Json         @default("{}")
  archivedAt     DateTime?

  indexedCustomValues CustomFieldSearchValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, businessUnitId])
  @@index([businessUnitId, archivedAt])
  @@index([teamId, ownerId])
  @@map("companyBusinessUnitState")
}

/// How much of a claim we believe, and what that licenses.
///
/// The bands are the behaviour, not a label: `VERIFIED` is written to the
/// record, `PROBABLE` is offered to a human, `POSSIBLE` is kept but never shown
/// as a value. The numeric `score` beside them exists so the thresholds can be
/// re-calibrated against evals without re-running the research.
enum FactBand {
  VERIFIED
  PROBABLE
  POSSIBLE
}

enum FactStatus {
  APPLIED
  PROPOSED
  DISMISSED
  SUPERSEDED
}

/// One claim about one field of one contact, with everything behind it.
///
/// The point of a separate table: `Contact.title` can only hold the answer,
/// and the answer is the least interesting part. This holds where it came
/// from, how sure we are, what else was considered, and what it replaced —
/// which is what makes an enriched field auditable rather than merely present.
///
/// It is deliberately *not* the read path. Current values stay denormalised on
/// `Contact` so a list is one query; this is the reasoning behind them.
model ContactFact {
  id        String  @id @default(cuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  /// The `Contact` column this is about — "title", "linkedinUrl", "employer".
  field String
  value String

  score Float
  band  FactBand

  /// The full ledger: `[{ kind, weight, detail, sourceUrl }]`. Kept so the
  /// score can be explained to a rep and recomputed after a re-calibration.
  evidence Json

  method    String
  sourceUrl String?

  /// The eve session that produced it, joining to `AgentEvent` for "show your
  /// work".
  sessionId String?

  status      FactStatus @default(PROPOSED)
  decidedById String?
  decidedBy   User?      @relation("FactDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?

  observedAt   DateTime  @default(now())
  supersededAt DateTime?

  @@index([contactId, field, status])
  @@index([status, observedAt])
  @@map("contactFact")
}

/// The background panel on a contact: who they are, in prose and in fields.
model ContactBrief {
  contactId String  @id
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  /// Two or three sentences. Present tense, their name first.
  narrative String
  /// `{ currentRole, tenure, previousRoles[], seniority, function, location }`
  /// — shaped by the agent, rendered by the sheet, so adding a line does not
  /// need a migration.
  sections  Json

  score     Float
  sourceUrl String?
  sessionId String?

  refreshedAt DateTime @default(now())

  @@map("contactBrief")
}

/// What the agent has decided to do, and why.
///
/// The work queue *and* the audit trail. A cron expression can only say "every
/// hour for everybody"; a row here says "this person, in fourteen days,
/// because a job change would move a live deal" — and the reason is shown to
/// the rep rather than buried in a prompt.
model AgentTask {
  id        String  @id @default(cuid())
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  kind   String
  reason String

  priority Int @default(0)
  /// Research units this task may spend. Depth is a decision, and this is
  /// what the agent decides it against.
  budget   Int @default(4)
  /// How many times this row has been handed to a session.
  ///
  /// The lease is a deadline rather than a flag so a crashed run frees its
  /// row — but a deadline alone cannot tell "died, retry me" from "cannot
  /// ever finish". Without a count the second case is re-leased every ten
  /// minutes forever, resuming the same durable session and paying for a
  /// model turn each time. Two rows did exactly that for an hour and a half.
  attempts Int @default(0)

  dueAt       DateTime
  /// Held by a dispatcher tick. An expired lease is free to reclaim, which is
  /// what makes a crashed run recoverable rather than stuck.
  leasedUntil DateTime?

  sessionId  String?
  startedAt  DateTime?
  finishedAt DateTime?
  outcome    String?

  createdAt DateTime @default(now())

  @@index([dueAt, leasedUntil])
  @@index([contactId])
  @@map("agentTask")
}

/// Installation-wide AI provider configuration. Secrets are encrypted before
/// they reach this table; the API only returns the last four characters.
model AiProviderConfiguration {
  id              String   @id @default(cuid())
  provider        String   @unique
  apiKeyEncrypted String?
  apiKeyLastFour  String?
  models          String[] @default([])
  /// Context window by approved model id. Dynamic Eve selections do not
  /// inherit this metadata from the fallback model.
  modelContextWindows Json @default("{}")
  defaults        Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("aiProviderConfiguration")
}

/// Installation-wide preferences for this deliberately single-tenant workspace.
model WorkspaceConfiguration {
  id        String   @id @default("default")
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workspaceConfiguration")
}

/// Every runtime event the agent emits, written by a hook.
///
/// The id is eve's own `meta.id` (a ULID), so an `on conflict do nothing`
/// insert is replay-safe: reconnecting to a stream, rewinding it, or restoring
/// a saved log cannot duplicate a row. Leading with a timestamp also keeps the
/// primary key roughly append-ordered.
///
/// This is what "show your work" reads. Without it the agent's reasoning lives
/// only in a log nobody can query and nobody can show a rep.
model AgentEvent {
  id        String  @id
  sessionId String
  contactId String?
  type      String
  data      Json

  emittedAt DateTime

  @@index([sessionId, emittedAt])
  @@index([contactId, emittedAt])
  @@map("agentEvent")
}

/// A conversation between a rep and the agent, about one record.
///
/// The transcript itself is already in `AgentEvent` — this is the *handle*: the
/// durable eve session to resume, and enough metadata to list a record's
/// history without reading a single event. Reopening a contact should show what
/// you asked last week rather than an empty box.
///
/// `sessionId` is unique because one eve session is one conversation. The
/// cursor beside it (`continuationToken`, `streamIndex`) is what `useEveAgent`
/// needs to pick the thread back up instead of starting a new one.
model AgentConversation {
  id String @id @default(cuid())

  /// Which record it is about. Exactly one of these is set.
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  /// Whose conversation. Two reps asking about the same contact are having two
  /// different conversations, and neither should see the other's half-finished
  /// question.
  userId String
  user   User   @relation("ConversationOwner", fields: [userId], references: [id], onDelete: Cascade)

  sessionId         String  @unique
  continuationToken String?
  /// How far the client had read, so a reopened thread does not replay.
  streamIndex       Int     @default(0)

  /// The first thing the rep asked, trimmed. Written once.
  title        String?
  messageCount Int     @default(0)

  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  @@index([contactId, lastMessageAt])
  @@index([companyId, lastMessageAt])
  @@index([dealId, lastMessageAt])
  @@map("agentConversation")
}

model Deal {
  id             String              @id @default(cuid())
  conversations  AgentConversation[]
  name           String
  companyId      String
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Required: every deal has a name against it.
  ownerId        String
  owner          User                @relation("DealOwner", fields: [ownerId], references: [id])
  businessUnitId String              @default("business-unit-default")
  businessUnit   BusinessUnit        @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  teamId         String?
  team           Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)

  pipelineId        String
  pipeline          Pipeline      @relation(fields: [pipelineId], references: [id])
  stageId           String
  stage             PipelineStage @relation(fields: [stageId, pipelineId], references: [id, pipelineId])
  stageChangedAt    DateTime      @default(now())
  amount            Decimal?      @db.Decimal(14, 2)
  currency          String        @default("USD")
  expectedCloseDate DateTime?
  closedAt          DateTime?
  closedReason      String?
  archivedAt        DateTime?
  customValues      Json          @default("{}")

  /// Denormalised max(activity.createdAt), written with the activity.
  ///
  /// A real column because it is a sortable column on every list, and ordering
  /// by an aggregate over a relation is something Prisma cannot express — the
  /// alternative is a correlated subquery per row, which would be the slowest
  /// thing on the page. Maintained through `ActivityStampService`.
  lastActivityAt DateTime?

  contacts            DealContact[]
  revenueAccounts     RevenueAccountDeal[]
  lineItems           DealLineItem[]
  activities          Activity[]
  conversionEvents    ConversionAttributionEvent[] @relation("ConversionDeal")
  indexedCustomValues CustomFieldSearchValue[]
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@index([companyId])
  @@index([ownerId])
  @@index([businessUnitId, teamId])
  @@index([pipelineId])
  @@index([stageId])
  @@index([expectedCloseDate])
  @@index([lastActivityAt])
  @@index([archivedAt])
  @@map("deal")
}

model Pipeline {
  id               String             @id @default(cuid())
  name             String
  isDefault        Boolean            @default(false)
  archivedAt       DateTime?
  businessUnitId   String?
  businessUnit     BusinessUnit?      @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  funnelType       PipelineFunnelType @default(FULL_BOWTIE)
  blueprintVersion Int                @default(1)

  stages            PipelineStage[]
  deals             Deal[]
  blueprintVersions PipelineBlueprintVersion[]
  conversionEvents  ConversionAttributionEvent[] @relation("ConversionPipeline")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([archivedAt, name])
  @@index([businessUnitId, archivedAt])
  @@map("pipeline")
}

model PipelineStage {
  id                        String            @id @default(cuid())
  pipelineId                String
  pipeline                  Pipeline          @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  /// Stable ontology key. Historical snapshots keep this value even if a label changes.
  key                       String            @default(cuid())
  name                      String
  position                  Int
  type                      PipelineStageType @default(OPEN)
  semanticPhase             String            @default("conversion")
  allowedRoleKeys           Json              @default("[]")
  responsibleRoleKey        String?
  defaultResponsibleRoleKey String?
  allowedNextStageIds       Json              @default("[]")

  deals            Deal[]
  conversionEvents ConversionAttributionEvent[] @relation("ConversionPipelineStage")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pipelineId, position])
  @@unique([pipelineId, key])
  @@unique([id, pipelineId])
  @@index([pipelineId, type])
  @@map("pipelineStage")
}

/// Immutable policy snapshot. A pipeline's `blueprintVersion` points at the
/// current row; old rows remain available for explaining historical deals.
model PipelineBlueprintVersion {
  id         String             @id @default(cuid())
  pipelineId String
  pipeline   Pipeline           @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  version    Int
  funnelType PipelineFunnelType
  snapshot   Json               @default("{}")
  createdAt  DateTime           @default(now())

  handoverRules PipelineHandoverRule[]

  @@unique([pipelineId, version])
  @@index([pipelineId, createdAt])
  @@map("pipelineBlueprintVersion")
}

/// A handover is attached to a version so changes never rewrite the rule that
/// was active when a deal crossed the boundary.
model PipelineHandoverRule {
  id                   String                   @id @default(cuid())
  blueprintVersionId   String
  blueprintVersion     PipelineBlueprintVersion @relation(fields: [blueprintVersionId], references: [id], onDelete: Cascade)
  fromStageId          String
  toStageId            String
  fromRoleKey          String
  toRoleKey            String
  acceptanceRequired   Boolean                  @default(false)
  acceptanceSlaMinutes Int?
  assignmentStrategy   String                   @default("manual")
  createdAt            DateTime                 @default(now())

  @@unique([blueprintVersionId, fromStageId, toStageId, fromRoleKey, toRoleKey])
  @@index([blueprintVersionId, fromStageId, toStageId])
  @@map("pipelineHandoverRule")
}

model Product {
