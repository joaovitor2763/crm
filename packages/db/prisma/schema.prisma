model RevenueAccountAttributeHistory {
  id               String         @id @default(cuid())
  revenueAccountId String
  revenueAccount   RevenueAccount @relation(fields: [revenueAccountId], references: [id], onDelete: Cascade)
  operationId      String
  fieldKey         String
  previousValue    Json?
  nextValue        Json?
  changedByType    AuditActorType
  changedById      String?
  source           String?
  changedAt        DateTime       @default(now())

  @@index([revenueAccountId, fieldKey, changedAt])
  @@index([operationId])
  @@map("revenueAccountAttributeHistory")
}

model RevenueAccountLineageEvent {
  id               String                         @id @default(cuid())
  revenueAccountId String
  revenueAccount   RevenueAccount                 @relation(fields: [revenueAccountId], references: [id], onDelete: Cascade)
  operationId      String
  type             RevenueAccountLineageEventType
  sourceType       String?
  sourceId         String?
  actorType        AuditActorType
  actorId          String?
  payload          Json                           @default("{}")
  createdAt        DateTime                       @default(now())

  @@index([revenueAccountId, createdAt])
  @@index([sourceType, sourceId])
  @@index([operationId])
  @@map("revenueAccountLineageEvent")
}

model RevenueAccountMerge {
  id              String         @id @default(cuid())
  sourceAccountId String
  sourceAccount   RevenueAccount @relation("RevenueAccountMergeSource", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  targetAccountId String
  targetAccount   RevenueAccount @relation("RevenueAccountMergeTarget", fields: [targetAccountId], references: [id], onDelete: Restrict)
  operationId     String
  policy          Json
  executedByType  AuditActorType
  executedById    String?
  createdAt       DateTime       @default(now())

  @@index([sourceAccountId, createdAt])
  @@index([targetAccountId, createdAt])
  @@unique([operationId])
  @@map("revenueAccountMerge")
}

/// Append-only normalized attribution history. Existing Activity and
/// LeadSubmission rows remain source records; the attribution service projects
/// them alongside these events so first/current touch never overwrite history.
/// Typed links are nullable on delete; entityType/entityId remain a stable
/// tombstone so merge and hard-delete never erase lineage.
model ConversionAttributionEvent {
  id               String               @id @default(cuid())
  entityType       ConversionEntityType
  entityId         String
  contactId        String?
  contact          Contact?             @relation("ConversionContact", fields: [contactId], references: [id], onDelete: SetNull)
  companyId        String?
  company          Company?             @relation("ConversionCompany", fields: [companyId], references: [id], onDelete: SetNull)
  dealId           String?
  deal             Deal?                @relation("ConversionDeal", fields: [dealId], references: [id], onDelete: SetNull)
  revenueAccountId String?
  revenueAccount   RevenueAccount?      @relation("ConversionRevenueAccount", fields: [revenueAccountId], references: [id], onDelete: SetNull)

  businessUnitId String
  businessUnit   BusinessUnit   @relation("ConversionBusinessUnit", fields: [businessUnitId], references: [id], onDelete: Restrict)
  teamId         String?
  team           Team?          @relation("ConversionTeam", fields: [teamId], references: [id], onDelete: SetNull)
  actorType      AuditActorType
  actorId        String?
  operationId    String

  channel          String?
  source           String?
  conversionType   String
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmTerm          String?
  utmContent       String?
  marketingFormId  String?
  marketingForm    MarketingForm?  @relation("ConversionMarketingForm", fields: [marketingFormId], references: [id], onDelete: SetNull)
  marketingEventId String?
  marketingEvent   MarketingEvent? @relation("ConversionMarketingEvent", fields: [marketingEventId], references: [id], onDelete: SetNull)
  pipelineId       String?
  pipeline         Pipeline?       @relation("ConversionPipeline", fields: [pipelineId], references: [id], onDelete: SetNull)
  pipelineStageId  String?
  pipelineStage    PipelineStage?  @relation("ConversionPipelineStage", fields: [pipelineStageId, pipelineId], references: [id, pipelineId], onDelete: SetNull)
  metadata         Json?
  occurredAt       DateTime        @default(now())
  createdAt        DateTime        @default(now())

  @@unique([entityType, entityId, operationId])
  @@index([entityType, entityId, occurredAt])
  @@index([businessUnitId, teamId, occurredAt])
  @@index([conversionType, occurredAt])
  @@index([source, occurredAt])
  @@index([pipelineId, occurredAt])
  @@index([operationId])
  @@map("conversionAttributionEvent")
}

model Activity {
  id      String       @id @default(cuid())
  type    ActivityType
  subject String?
  body    String?

  /// Set when the thing already happened.
  occurredAt  DateTime?
  /// Set when it is scheduled. Overdue is dueAt in the past with no completedAt.
  dueAt       DateTime?
  completedAt DateTime?

  businessUnitId String       @default("business-unit-default")
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  teamId         String?
  team           Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  /// Always stamped when it can be resolved, even for deal and contact
  /// activity, so a company timeline is one indexed range scan rather than
  /// three joins.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  marketingFormId  String?
  marketingForm    MarketingForm?  @relation(fields: [marketingFormId], references: [id], onDelete: SetNull)
  marketingEventId String?
  marketingEvent   MarketingEvent? @relation(fields: [marketingEventId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("ActivityAuthor", fields: [createdById], references: [id])
  /// { from, to } for STAGE_CHANGE; the credit cost for ENRICHMENT; `{ synced:
  /// true }` for anything a Google sync projected.
  meta        Json?

  /// The projection links. Unique because a thread and an event each get exactly
  /// one timeline entry, updated in place as the thread grows or the event moves
  /// — the timeline stays one indexed range scan instead of a three-table union.
  emailThreadId   String?        @unique
  emailThread     EmailThread?   @relation(fields: [emailThreadId], references: [id], onDelete: Cascade)
  calendarEventId String?        @unique
  calendarEvent   CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, createdAt])
  @@index([dealId, createdAt])
  @@index([contactId, createdAt])
  @@index([dueAt])
  @@index([createdById])
  @@index([businessUnitId, teamId, createdAt])
  @@index([marketingFormId, createdAt])
  @@index([marketingEventId, createdAt])
  @@map("activity")
}

model MarketingForm {
  id             String        @id @default(cuid())
  name           String
  externalId     String?       @unique
  archivedAt     DateTime?
  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  conversions      Activity[]
  conversionEvents ConversionAttributionEvent[] @relation("ConversionMarketingForm")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([archivedAt, name])
  @@index([businessUnitId, archivedAt])
  @@map("marketingForm")
}

model MarketingEvent {
  id             String        @id @default(cuid())
  name           String
  startsAt       DateTime?
  endsAt         DateTime?
  location       String?
  archivedAt     DateTime?
  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  attendances      Activity[]
  conversionEvents ConversionAttributionEvent[] @relation("ConversionMarketingEvent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([archivedAt, startsAt])
  @@index([businessUnitId, archivedAt])
  @@map("marketingEvent")
}

/// Every intake attempt survives independently from the canonical Contact. A
/// rejection does not pollute the active contact list, but it remains reviewable
/// and replayable with the exact validation outcome that produced it.
model LeadSubmission {
  id                String               @id @default(cuid())
  source            String
  externalId        String?
  idempotencyKey    String?
  status            LeadSubmissionStatus
  payload           Json
  normalizedPayload Json?
  reasons           Json?

  businessUnitId      String         @default("business-unit-default")
  businessUnit        BusinessUnit   @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  teamId              String?
  team                Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  /// New unassigned rows use `none`; deleted teams retain `team:<id>` as a tombstone namespace.
  idempotencyScopeKey String         @default(dbgenerated("'none'"))
  contactId           String?
  contact             Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  receivedByType      AuditActorType
  receivedById        String?

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([source, businessUnitId, idempotencyScopeKey, externalId])
  @@unique([source, businessUnitId, idempotencyScopeKey, idempotencyKey])
  @@index([businessUnitId, status, receivedAt])
  @@index([teamId, status, receivedAt])
  @@index([contactId])
  @@map("leadSubmission")
}

model AuditEvent {
  id             String         @id @default(cuid())
  actorType      AuditActorType
  actorId        String?
  action         String
  resource       String
  recordId       String?
  businessUnitId String?
  businessUnit   BusinessUnit?  @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  teamId         String?
  team           Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  requestId      String?
  metadata       Json?
  createdAt      DateTime       @default(now())

  @@index([resource, recordId, createdAt])
  @@index([actorType, actorId, createdAt])
  @@index([businessUnitId, teamId, createdAt])
  @@index([createdAt])
  @@map("auditEvent")
}

model ApiCredential {
