  lastUsedAt  DateTime?
  createdById String
  createdBy   User                @relation("ApiCredentialCreator", fields: [createdById], references: [id], onDelete: Restrict)

  businessUnits ApiCredentialBusinessUnit[]
  teams         ApiCredentialTeam[]

