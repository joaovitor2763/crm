model Automation {
  id             String           @id @default(cuid())
  name           String
  description    String?
  status         AutomationStatus @default(DRAFT)
  version        Int              @default(1)
  roleId         String
  role           Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  businessUnitId String?
  businessUnit   BusinessUnit?    @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  teamId         String?
  team           Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  trigger        Json
  conditions     Json
  actions        Json
  createdById    String
  createdBy      User             @relation("AutomationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  archivedAt     DateTime?

  runs AutomationRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, archivedAt])
  @@index([businessUnitId, teamId, status])
  @@index([roleId])
  @@map("automation")
}

/// Transactional outbox and durable queue. `eventKey` is the producer's stable
/// idempotency key; leases make crashed workers recoverable.
model DomainEvent {
  id             String         @id @default(cuid())
  eventKey       String         @unique
  type           String
  resource       String
  recordId       String?
  businessUnitId String?
  businessUnit   BusinessUnit?  @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  teamId         String?
  team           Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  actorType      AuditActorType
  actorId        String?
  payload        Json
  causationId    String?
  depth          Int            @default(0)
  attempts       Int            @default(0)
  availableAt    DateTime       @default(now())
  leasedUntil    DateTime?
  completedAt    DateTime?
  occurredAt     DateTime       @default(now())

  automationRuns    AutomationRun[]
  webhookDeliveries WebhookDelivery[]

  @@index([availableAt, leasedUntil])
  @@index([type, occurredAt])
  @@index([businessUnitId, teamId, occurredAt])
  @@index([causationId])
  @@map("domainEvent")
}

model AutomationRun {
  id           String              @id @default(cuid())
  automationId String
  automation   Automation          @relation(fields: [automationId], references: [id], onDelete: Cascade)
  eventId      String
  event        DomainEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  version      Int
  status       AutomationRunStatus @default(QUEUED)
  attempts     Int                 @default(0)
  availableAt  DateTime            @default(now())
  leasedUntil  DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  errorCode    String?
  output       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([automationId, eventId, version])
  @@index([status, availableAt, leasedUntil])
  @@index([eventId])
  @@map("automationRun")
}

model WebhookEndpoint {
  id             String        @id @default(cuid())
  name           String
  url            String
  eventTypes     Json
  isActive       Boolean       @default(true)
  secretVersion  Int           @default(1)
  secretLastFour String
  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  teamId         String?
  team           Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User          @relation("WebhookEndpointCreator", fields: [createdById], references: [id], onDelete: Restrict)
  archivedAt     DateTime?

  deliveries WebhookDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessUnitId, teamId, isActive])
  @@index([archivedAt])
  @@map("webhookEndpoint")
}

model WebhookDelivery {
  id             String                @id @default(cuid())
  endpointId     String
  endpoint       WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventId        String
  event          DomainEvent           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventType      String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  availableAt    DateTime              @default(now())
  leasedUntil    DateTime?
  deliveredAt    DateTime?
  responseStatus Int?
  errorCode      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([endpointId, eventId])
  @@index([status, availableAt, leasedUntil])
  @@index([eventType, createdAt])
  @@map("webhookDelivery")
}

// ---------------------------------------------------------------------------
// Google sync
//
// Gmail threads and Calendar events get real tables; the timeline gets one
// projected Activity per thread and per event. Identity is deliberately global
// rather than Google's per-mailbox ids — see docs/plan/gmail-calendar-plan.md §4.2.
// ---------------------------------------------------------------------------

enum GoogleSyncStatus {
  IDLE
  RUNNING
  /// The refresh token is gone. Stop trying; the rep has to reconnect.
  NEEDS_RECONNECT
  FAILED
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

/// Per-user, per-source cursor.
///
/// In Postgres because the API is a serverless function with no memory between
/// invocations, and because the in-process EnrichmentQueue deliberately drops
/// queued work on shutdown — fine for enrichment, fatal for a resumable sync.
model MailboxSync {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "gmail" | "calendar".
  source String

  status       GoogleSyncStatus @default(IDLE)
  /// Gmail: the last processed historyId. Calendar: nextSyncToken.
  ///
  /// Stamped with "now" the first time a mailbox is seen, which is what makes
  /// this forward-only: there is no backfill, so the cursor starts at the
  /// moment of connection and nothing before it is ever read.
  cursor       String?
  lastSyncedAt DateTime?
  lastError    String?
  /// Set by the 429/403 handler; the cron skips this row until it passes.
  retryAfter   DateTime?
  /// Auto-creation is opt-in per source — on for calendar, off for Gmail.
  autoCreate   Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, source])
  @@index([status])
  @@map("mailboxSync")
}

/// One conversation, whoever's mailbox it came from.
model EmailThread {
  id            String  @id @default(cuid())
  /// The RFC 822 Message-ID of the thread root — global, unlike Gmail's
  /// mailbox-scoped threadId. This is what stops two reps on one thread
  /// producing two CRM threads.
  rootMessageId String  @unique
  subject       String?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  firstMessageAt DateTime
  lastMessageAt  DateTime
  messageCount   Int      @default(0)

  messages EmailMessage[]
  activity Activity?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, lastMessageAt])
  @@index([contactId, lastMessageAt])
  @@map("emailThread")
}

model EmailMessage {
  id       String      @id @default(cuid())
  threadId String
  thread   EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  /// Global message identity. Unique, so account B's sync skips what account A
  /// already ingested.
  rfcMessageId   String  @unique
  /// Whose mailbox produced this copy, and its id there — for deep links.
  syncedByUserId String?
  gmailMessageId String?

  direction  EmailDirection
  fromEmail  String
  fromName   String?
  /// [{ email, name, kind: "to" | "cc" }]. Not a table: nothing queries it.
  recipients Json
  subject    String?
  snippet    String?
  /// Plain text, quoted history stripped. Never logged; never in list payloads.
  body       String?
  sentAt     DateTime

  createdAt DateTime @default(now())

  @@index([threadId, sentAt])
  @@map("emailMessage")
}

model CalendarEvent {
  id                String   @id @default(cuid())
  /// Shared by every attendee's copy of the event, and by every instance of a
  /// recurrence — which is why the start time is part of the key.
  iCalUid           String
  originalStartTime DateTime
  /// Set on an instance of a recurring series.
  recurringEventId  String?

  title          String?
  description    String?
  location       String?
  conferenceUrl  String?
  startsAt       DateTime
  endsAt         DateTime
  isAllDay       Boolean  @default(false)
  status         String
  organizerEmail String?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  syncedByUserId String?
  googleEventId  String?

  attendees CalendarAttendee[]
  activity  Activity?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([iCalUid, originalStartTime])
  @@index([companyId, startsAt])
  @@index([contactId, startsAt])
  @@map("calendarEvent")
}

model CalendarAttendee {
  id      String        @id @default(cuid())
  eventId String
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  email          String
  name           String?
  /// needsAction | declined | tentative | accepted
  responseStatus String?
  isOrganizer    Boolean  @default(false)
  contactId      String?
  contact        Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([eventId, email])
  @@index([contactId])
  @@map("calendarAttendee")
}

/// Domains we never match on and never create from — vendors, ATSs, newsletters.
/// Grows by hand and by a "not a customer" action in the UI.
model SuppressedDomain {
  domain    String   @id
  reason    String?
  createdAt DateTime @default(now())

  @@map("suppressedDomain")
}
